<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ED-Overdrive</AssemblyName>
    <RootNamespace>GenFrame.Setup</RootNamespace>
    <Version>0.1.0</Version>
    <Product>ED-Overdrive</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- GITC Uplift (MIT, github.com/ghostinthecamera/GITC-Uplift): shipped inside the exe, checked by hash at install. -->
    <EmbeddedResource Include="ThirdParty\GITC-Uplift-1.8.0.zip" LogicalName="GITC-Uplift.zip" />
  </ItemGroup>

</Project>
